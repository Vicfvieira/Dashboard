# Copie para .env e preencha. Nunca versione o .env.

# Neon — com pooling (host com "-pooler"), usado pela aplicação
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon — conexão direta (sem "-pooler"), usada pelo Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""

# Integração com o Pelagem Studio (header x-api-key)
PELAGEM_API_URL="https://pelagem.example.vercel.app"
PELAGEM_API_KEY=""

# Integração com a Lírio (header x-api-key)
LIRIO_API_URL="https://lirio.example.vercel.app"
LIRIO_API_KEY=""

# Cron da Vercel — enviado como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Senhas dos usuários do seed (mínimo de 12 caracteres)
SEED_ADMIN_PASSWORD=""
SEED_GESTOR_PASSWORD=""
SEED_ATENDENTE_PASSWORD=""
SEED_DEMO_PASSWORD=""
